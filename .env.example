SERVER_PORT=8080

DB_URL=jdbc:mysql://localhost:3306/resource_booking?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=root

JPA_DDL_AUTO=update

# Required for default and prod profiles. At least 32 characters.
# The app will not start if this is missing or still a placeholder.
JWT_SECRET=
JWT_EXPIRATION_MS=86400000

# Demo users are off unless you opt in (dev/h2 profiles set this to true).
# Prod refuses to seed even if this is true.
# APP_SEED_ENABLED=true
# SEED_ADMIN_PASSWORD=
# SEED_USER_PASSWORD=

# Explicit browser origins only. Wildcards (*) are rejected at startup.
# APP_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
