{
  "info": {
    "name": "Resource Booking API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "JWT-secured Resource Booking System. Login first, then set the Bearer token on subsequent requests."
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "adminToken", "value": "" },
    { "key": "userToken", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login as ADMIN",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"Admin@123\"\n}"
            },
            "url": "{{baseUrl}}/auth/login"
          }
        },
        {
          "name": "Login as USER",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"user\",\n  \"password\": \"User@123\"\n}"
            },
            "url": "{{baseUrl}}/auth/login"
          }
        }
      ]
    },
    {
      "name": "Resources",
      "item": [
        {
          "name": "List resources",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{userToken}}" }],
            "url": "{{baseUrl}}/api/resources?page=0&size=10"
          }
        },
        {
          "name": "Get resource by id",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{userToken}}" }],
            "url": "{{baseUrl}}/api/resources/1"
          }
        },
        {
          "name": "Create resource (ADMIN)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Meeting Room B\",\n  \"description\": \"6-person room\",\n  \"type\": \"ROOM\",\n  \"location\": \"Floor 1\",\n  \"hourlyRate\": 25.00,\n  \"available\": true\n}"
            },
            "url": "{{baseUrl}}/api/resources"
          }
        },
        {
          "name": "Update resource (ADMIN)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Meeting Room B\",\n  \"description\": \"Updated description\",\n  \"type\": \"ROOM\",\n  \"location\": \"Floor 1\",\n  \"hourlyRate\": 28.50,\n  \"available\": true\n}"
            },
            "url": "{{baseUrl}}/api/resources/4"
          }
        },
        {
          "name": "Delete resource (ADMIN)",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": "{{baseUrl}}/api/resources/4"
          }
        }
      ]
    },
    {
      "name": "Reservations",
      "item": [
        {
          "name": "List reservations with filters",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": "{{baseUrl}}/api/reservations?status=PENDING&minPrice=10&maxPrice=200&page=0&size=10&sort=price,asc"
          }
        },
        {
          "name": "Get reservation by id",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{userToken}}" }],
            "url": "{{baseUrl}}/api/reservations/1"
          }
        },
        {
          "name": "Create reservation (USER)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{userToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"resourceId\": 1,\n  \"startTime\": \"2026-10-20T09:00:00\",\n  \"endTime\": \"2026-10-20T11:00:00\",\n  \"price\": 100.00\n}"
            },
            "url": "{{baseUrl}}/api/reservations"
          }
        },
        {
          "name": "Update reservation (ADMIN)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"resourceId\": 1,\n  \"startTime\": \"2026-10-20T09:00:00\",\n  \"endTime\": \"2026-10-20T12:00:00\",\n  \"price\": 150.00,\n  \"status\": \"CONFIRMED\"\n}"
            },
            "url": "{{baseUrl}}/api/reservations/1"
          }
        },
        {
          "name": "Cancel reservation",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{userToken}}" }],
            "url": "{{baseUrl}}/api/reservations/1/cancel"
          }
        },
        {
          "name": "Delete reservation (ADMIN)",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": "{{baseUrl}}/api/reservations/1"
          }
        }
      ]
    }
  ]
}
